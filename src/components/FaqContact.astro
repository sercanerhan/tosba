---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { CarListing } from "../lib/listing-schema";
import { mediaById } from "../data/media";

type Props = { listing: CarListing };
const { listing } = Astro.props;
const footer = mediaById["orbital-horizon"]!;
---

<section class="faq chapter" id="sss" aria-labelledby="faq-title">
  <div class="content-shell faq__grid">
    <div class="chapter__heading">
      <p class="eyebrow">Sık sorulanlar</p>
      <h2 id="faq-title">Aklınızdaki sorular, açık cevaplar.</h2>
    </div>
    <div class="faq__list">
      {listing.faq.map((item, index) => (
        <details open={index === 0}>
          <summary>
            <span>{item.question}</span>
            <Icon name="ph:plus" aria-hidden="true" />
          </summary>
          <div><p>{item.answer}</p><small class="technical">KAYNAK · {item.sources.includes("fotograf") ? "İLK SAHİBİ KAYDI + FOTOĞRAF" : "İLK SAHİBİ KAYDI"}</small></div>
        </details>
      ))}
      <details>
        <summary><span>Eksik bilgiler neden boş görünüyor?</span><Icon name="ph:plus" aria-hidden="true" /></summary>
        <div><p>Kilometre, DOT ve servis tarihi gibi alanlar teyit edilmeden kesin bilgi olarak sunulmaz. Bu kalıcı arşiv, yalnızca elde kalan kayıtlarla güncellenir.</p><small class="technical">ŞEFFAFLIK İLKESİ</small></div>
      </details>
    </div>
  </div>
</section>

<footer class="archive-footer" id="veda">
  <div class="archive-footer__visual" aria-hidden="true">
    <Picture src={footer.src} formats={["avif"]} fallbackFormat="webp" widths={[768, 1280, 1920]} sizes="100vw" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="archive-footer__wash" aria-hidden="true"></div>
  <div class="page-shell archive-footer__inner">
    <p class="eyebrow">Yolun devam ediyor</p>
    <h2>Yolun açık olsun,<br />{listing.car.nickname}.</h2>
    <p>8 Mart 2012'de başlayan 14 yıllık ilk sahiplik hikâyesi 14 Eylül 2026'da tamamlandı. Bu site, Tosba'nın kalıcı hatırası olarak yaşamaya devam edecek.</p>
    <a class="action action--primary archive-footer__action" href="#top">
      <Icon name="ph:arrow-up" aria-hidden="true" />
      Başa dön
    </a>
    <div class="archive-footer__meta technical">
      <span>{listing.car.nickname} · {listing.car.modelYear} {listing.car.make} {listing.car.model}</span>
      <span>08.03.2012 · 14.09.2026</span>
    </div>
  </div>
</footer>

<style>
  .faq { border-top: 1px solid var(--border-default); background: var(--surface-primary); }
  .faq__grid { display: grid; grid-template-columns: minmax(280px, .8fr) minmax(0, 1.2fr); gap: var(--space-20); }
  .faq__list { border-top: 1px solid var(--border-default); }
  details { border-bottom: 1px solid var(--border-default); }
  summary { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); cursor: pointer; list-style: none; font-size: var(--type-lead); }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: 0 0 auto; width: 1rem; height: 1rem; transition: transform 240ms var(--ease-standard); }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  details > div { display: grid; gap: var(--space-4); padding: 0 var(--space-12) var(--space-6) 0; }
  details p { color: var(--text-secondary); }
  details small { color: var(--text-tertiary); font-size: var(--type-micro); }
  .archive-footer { position: relative; min-height: 88dvh; display: grid; align-items: center; overflow: hidden; isolation: isolate; border-top: 1px solid var(--border-default); background: var(--surface-void); }
  .archive-footer__visual,
  .archive-footer__wash { position: absolute; inset: 0; }
  .archive-footer__visual { z-index: -2; opacity: .62; }
  .archive-footer__visual :global(picture),
  .archive-footer__visual :global(img) { width: 100%; height: 100%; }
  .archive-footer__visual :global(img) { object-fit: cover; object-position: center bottom; }
  .archive-footer__wash { z-index: -1; background: var(--overlay-soft); }
  .archive-footer__inner { display: grid; justify-items: center; gap: var(--space-6); padding-block: var(--space-24); text-align: center; }
  .archive-footer h2 { max-width: 12ch; font-size: var(--type-h1); font-weight: 500; line-height: 1; letter-spacing: -.04em; }
  .archive-footer__inner > p:not(.eyebrow) { max-width: 58ch; color: var(--text-secondary); font-size: var(--type-lead); }
  .archive-footer__action { min-width: min(100%, 240px); }
  .archive-footer__meta { position: absolute; inset: auto var(--page-pad) var(--space-6); display: flex; justify-content: space-between; gap: var(--space-4); color: var(--text-tertiary); font-size: var(--type-micro); }
  @media (max-width: 767px) {
    .faq__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    summary { font-size: var(--type-body); }
    .archive-footer { min-height: 100dvh; }
    .archive-footer__action { width: 100%; }
    .archive-footer__meta { position: static; flex-direction: column; align-items: center; margin-top: var(--space-8); }
  }
</style>
